DEBUG=false
SERVICE_NAME=async-payment-processing-service
APP_VERSION=0.1.0
ENVIRONMENT=dev
LOG_LEVEL_RULES=uvicorn.access:WARNING,sqlalchemy.engine:WARNING
API_KEY=development-only-key

# Локальные процессы используют localhost; Compose подставляет имена сервисов.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_VHOST=/
RABBITMQ_CONNECT_TIMEOUT=5
RABBITMQ_PUBLISH_TIMEOUT=5

OUTBOX_POLL_INTERVAL=1
OUTBOX_BATCH_SIZE=100

WEBHOOK_TIMEOUT=5
